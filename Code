                                    Completed
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <td>#ORD-004</td>
                            <td>Usman Ali</td>
                            <td>Nov 04, 2026</td>
                            <td>$150</td>
                            <td>
                                <span class="status pending">
                                    Pending
                                </span>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </section>


    <!-- =================================
         EMPTY / LOADING VERSION
    ================================== -->

    <section id="emptyVersion" class="hidden">

        <!-- EMPTY STAT CARDS -->

        <div class="stats-grid">

            <div class="stat-card">
                <p class="stat-label">Total Revenue</p>
                <h2 class="stat-value">--</h2>
                <div class="skeleton" style="width:65%"></div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Total Orders</p>
                <h2 class="stat-value">--</h2>
                <div class="skeleton" style="width:65%"></div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Total Customers</p>
                <h2 class="stat-value">--</h2>
                <div class="skeleton" style="width:65%"></div>
            </div>

            <div class="stat-card">
                <p class="stat-label">Conversion Rate</p>
                <h2 class="stat-value">--</h2>
                <div class="skeleton" style="width:65%"></div>
            </div>

        </div>


        <!-- EMPTY CHART -->

        <div class="content-card">

            <div class="card-header">
                <h2 class="card-title">Revenue Analytics</h2>
            </div>

            <div class="empty-state">

                <div class="empty-icon">📊</div>

                <h3>No Analytics Data Yet</h3>

                <p>
                    Your chart will appear here once data is available.
                </p>

                <button class="btn btn-primary">
                    Refresh Data
                </button>

            </div>

        </div>


        <!-- EMPTY TABLE -->

        <div class="content-card">

            <div class="card-header">
                <h2 class="card-title">Recent Orders</h2>
            </div>

            <div class="empty-state">

                <div class="empty-icon">📁</div>

                <h3>No Orders Found</h3>

                <p>
                    There are currently no orders to display.
                    New records will appear here.
                </p>

                <button class="btn btn-secondary">
                    Clear Filters
                </button>

            </div>

        </div>

    </section>

</main>

</div>


<!-- =================================
     13. JAVASCRIPT INTERACTIONS
================================= -->

<script>

// SIDEBAR ACTIVE STATE

function selectNav(selectedItem) {

    const navItems = document.querySelectorAll(".nav-item");

    navItems.forEach(item => {
        item.classList.remove("active");
    });

    selectedItem.classList.add("active");
}


// SHOW DATA VERSION

function showData() {

    document.getElementById("dataVersion")
        .classList.remove("hidden");

    document.getElementById("emptyVersion")
        .classList.add("hidden");

    document.getElementById("dataButton")
        .className = "btn btn-primary";

    document.getElementById("emptyButton")
        .className = "btn btn-secondary";
}


// SHOW EMPTY / LOADING VERSION

function showEmpty() {

    document.getElementById("emptyVersion")
        .classList.remove("hidden");

    document.getElementById("dataVersion")
        .classList.add("hidden");

    document.getElementById("emptyButton")
        .className = "btn btn-primary";

    document.getElementById("dataButton")
        .className = "btn btn-secondary";
}

</script>

</body>
