<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Analytics Dashboard Design System</title>

<style>
/* =================================
   1. DESIGN SYSTEM / COLOR TOKENS
================================= */

:root {
    --primary: #635BDB;
    --primary-dark: #4F46C8;
    --primary-light: #EEEDFF;

    --background: #F6F7FB;
    --surface: #FFFFFF;

    --text: #20243A;
    --muted: #85899C;
    --border: #E8E9F0;

    --success: #20A779;
    --success-light: #E4F7EF;

    --danger: #E45C67;
    --danger-light: #FDECEE;

    --warning: #E5A23C;

    --radius: 12px;
    --radius-small: 8px;

    --space-1: 4px;
    --space-2: 8px;
    --space-3: 12px;
    --space-4: 16px;
    --space-5: 20px;
    --space-6: 24px;
    --space-8: 32px;

    --shadow: 0 3px 15px rgba(30, 35, 70, 0.04);
}

/* =================================
   2. GENERAL STYLES
================================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: var(--background);
    color: var(--text);
}

button, input {
    font: inherit;
}

.app {
    display: flex;
    min-height: 100vh;
}

/* =================================
   3. SIDEBAR COMPONENT
================================= */

.sidebar {
    width: 245px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
}

.logo {
    font-size: 22px;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 40px;
    padding-left: 12px;
}

.nav-label {
    color: var(--muted);
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1px;
    margin: 20px 12px 12px;
}

.nav-item {
    width: 100%;
    padding: 13px 14px;
    border: none;
    background: transparent;
    color: var(--muted);
    border-radius: var(--radius-small);
    text-align: left;
    cursor: pointer;
    margin-bottom: 6px;
    transition: 0.2s;
}

.nav-item:hover {
    background: var(--primary-light);
    color: var(--primary);
}

.nav-item.active {
    background: var(--primary-light);
    color: var(--primary);
    font-weight: bold;
}

.profile {
    margin-top: auto;
    padding: 15px 10px;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 12px;
}

.avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--primary-light);
    color: var(--primary);
    display: grid;
    place-items: center;
    font-weight: bold;
}

/* =================================
   4. MAIN CONTENT
================================= */

.main {
    flex: 1;
    padding: 30px 36px;
    min-width: 0;
}

.topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 35px;
}

.page-title {
    font-size: 25px;
    font-weight: 700;
}

.subtitle {
    color: var(--muted);
    font-size: 13px;
    margin-top: 7px;
}

.top-actions {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* =================================
   5. BUTTON COMPONENTS
================================= */

.btn {
    padding: 11px 18px;
    border-radius: var(--radius-small);
    border: 1px solid transparent;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}

.btn-primary {
    background: var(--primary);
    color: white;
}

.btn-primary:hover {
    background: var(--primary-dark);
}

.btn-secondary {
    background: white;
    color: var(--text);
    border-color: var(--border);
}

.btn-secondary:hover {
    background: var(--background);
}

.btn:active {
    transform: scale(0.97);
}

.btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
}

/* =================================
   6. INPUT FIELD COMPONENT
================================= */

.input-field {
    padding: 11px 14px;
    width: 220px;
    border: 1px solid var(--border);
    border-radius: var(--radius-small);
    outline: none;
    background: white;
    font-size: 13px;
}

.input-field:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-light);
}

/* =================================
   7. STATISTIC CARD COMPONENTS
================================= */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-bottom: 28px;
}

.stat-card {
    background: var(--surface);
    padding: 23px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
}

.stat-label {
    color: var(--muted);
    font-size: 13px;
}

.stat-value {
    font-size: 27px;
    font-weight: bold;
    margin: 15px 0 10px;
}

.stat-change {
    font-size: 12px;
    color: var(--success);
    font-weight: bold;
}

/* =================================
   8. CONTENT CARDS
================================= */

.content-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    box-shadow: var(--shadow);
    margin-bottom: 24px;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
}

.card-title {
    font-size: 17px;
    font-weight: bold;
}

/* =================================
   9. CHART COMPONENT
================================= */

.chart {
    height: 190px;
    display: flex;
    align-items: end;
    justify-content: space-around;
    gap: 18px;
    border-bottom: 1px solid var(--border);
    padding: 10px 12px 0;
}

.bar-group {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: end;
    align-items: center;
    gap: 9px;
    flex: 1;
}

.bar {
    width: 65%;
    max-width: 45px;
    background: var(--primary);
    border-radius: 6px 6px 0 0;
    min-height: 10px;
    transition: 0.2s;
}

.bar:hover {
    background: var(--primary-dark);
}

.bar-label {
    font-size: 11px;
    color: var(--muted);
    margin-bottom: 10px;
}

/* =================================
   10. TABLE COMPONENT
================================= */

.table-wrapper {
    overflow-x: auto;
}

table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

th {
    color: var(--muted);
    font-size: 12px;
    font-weight: 600;
    padding: 14px 12px;
    border-bottom: 1px solid var(--border);
}

td {
    padding: 17px 12px;
    font-size: 13px;
    border-bottom: 1px solid var(--border);
}

.status {
    padding: 6px 10px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: bold;
}

.completed {
    background: var(--success-light);
    color: var(--success);
}

.pending {
    background: #FFF4E1;
    color: var(--warning);
}

/* =================================
   11. EMPTY / LOADING COMPONENTS
================================= */

.empty-state {
    text-align: center;
    padding: 65px 20px;
}

.empty-icon {
    font-size: 45px;
    margin-bottom: 18px;
}

.empty-state h3 {
    font-size: 19px;
    margin-bottom: 10px;
}

.empty-state p {
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 22px;
}

.skeleton {
    height: 15px;
    border-radius: 6px;
    background: linear-gradient(
        90deg,
        #ECEEF4 25%,
        #F7F8FC 50%,
        #ECEEF4 75%
    );
    background-size: 200% 100%;
    animation: loading 1.5s infinite;
}

@keyframes loading {
    from { background-position: 200% 0; }
    to { background-position: -200% 0; }
}

.hidden {
    display: none !important;
}

/* =================================
   12. RESPONSIVE DESIGN
================================= */

@media (max-width: 1000px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        width: 190px;
    }
}

@media (max-width: 650px) {
    .sidebar {
        width: 65px;
        padding: 20px 8px;
    }

    .logo {
        font-size: 13px;
        padding: 0;
        text-align: center;
    }

    .nav-label,
    .nav-text,
    .profile-info {
        display: none;
    }

    .nav-item {
        text-align: center;
        padding: 14px 5px;
    }

    .profile {
        justify-content: center;
    }

    .main {
        padding: 20px 14px;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .input-field {
        width: 100%;
    }

    .topbar {
        align-items: flex-start;
    }
}
</style>
</head>

<body>

<div class="app">

<!-- =================================
     SIDEBAR NAVIGATION
================================= -->

<aside class="sidebar">

    <div class="logo">◈ DashFlow</div>

    <div class="nav-label">MAIN MENU</div>

    <button class="nav-item active" onclick="selectNav(this)">
